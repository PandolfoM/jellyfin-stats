# Jellyfin connection — fill these in a local .env, never commit real values.
#
# JELLYFIN_URL must be reachable from wherever it's actually used, which
# differs by how you run this app (see the README's "Running the app"
# section). For the host-side dev flow, a value like the example below
# (or http://localhost:8096, if Jellyfin runs on this same machine) is fine.
# Under `docker compose up -d`, though, the app runs *inside* a container,
# where "localhost" means the container itself — a host-facing JELLYFIN_URL
# silently fails to connect there, the same class of bug DATABASE_URL had
# until docker-compose.yml started repointing it at the compose network.
# docker-compose.yml cannot do the same fix for JELLYFIN_URL, because
# Jellyfin isn't a compose service it manages — point this at your machine's
# LAN IP, a real hostname, or host.docker.internal (Docker Desktop only)
# instead.
JELLYFIN_URL=http://jellyfin.example.local:8096
JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key

# Database
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://jfstats:replace-with-a-strong-password@localhost:5432/jfstats

# Emergency fallback administrator (optional; BOTH must be set to activate it).
# Leave both unset — as they are here — and the door is shut: the only way in is
# a Jellyfin administrator account. When set, these credentials are accepted by
# /api/auth/login *before* Jellyfin is contacted at all, so they still work when
# Jellyfin itself is down. That is the point of them, and also why they are a
# standing password on your dashboard: set them only if you need the recovery
# path, use a long random password, and remove them once you are back in.
# FALLBACK_ADMIN_USER=rescue
# FALLBACK_ADMIN_PASSWORD=replace-with-a-long-random-password

# Tuning (optional; these are the defaults)
SESSION_POLL_INTERVAL_MS=5000
REFERENCE_SYNC_INTERVAL_MS=900000
COMPLETION_THRESHOLD=0.9
LOG_LEVEL=info
# Under `docker compose up -d`, this is also the host port the dashboard is
# published on: docker-compose.yml passes it straight through to the
# container and maps that same value on the host side, so the two ports
# always agree — see docker-compose.yml's `app` service for how.
PORT=3000

# Set to true when serving over HTTPS. Leave false for plain-HTTP local runs —
# a Secure cookie is silently dropped by the browser over HTTP, which looks
# exactly like a broken login.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Set to true ONLY when this app sits behind a reverse proxy that sets
# X-Forwarded-For itself (nginx, Caddy, Traefik, etc.). The login rate limiter
# keys attempts by this header when trust is on. Without a real proxy in
# front, X-Forwarded-For is just a header any client can set to any value —
# enabling this without one lets an attacker forge a fresh identity on every
# request and defeats the rate limit entirely. Leave false for a direct,
# unproxied deployment; the limiter then keys by the actual TCP connection.
TRUST_PROXY_HEADERS=false

# docker-compose.yml publishes Postgres to 127.0.0.1:5432 on the host (loopback
# only, not the LAN) — that's for host-side tooling: this DATABASE_URL, a local
# `psql`, etc. The `app` container never uses it; it reaches Postgres over the
# compose network by service name instead (docker-compose.yml repoints
# DATABASE_URL to that for the `app` service specifically). Already using port
# 5432 for something else on this machine? Change the host side of that
# `ports:` mapping in docker-compose.yml, and update this DATABASE_URL to match.
