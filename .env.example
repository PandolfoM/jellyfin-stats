# Copy to .env and fill in the three required values. Never commit real values.
#
# `docker compose up -d` reads this file to expand the ${...} references in
# docker-compose.yml. The three marked REQUIRED have no default and fail the
# `up` immediately if unset. Everything else is optional.
#
# The host-side dev flow (`pnpm --filter @jfstats/server dev`, `seed`,
# `backfill`) loads this whole file as its process environment instead, so a
# few settings below are labelled as applying to one path or the other.

# REQUIRED. Must be reachable FROM INSIDE A CONTAINER under docker compose:
# "localhost" there means the container itself, not your host. Use a LAN IP or
# hostname, host.docker.internal on Docker Desktop, or — if Jellyfin is a
# service in the same compose project — its service name.
JELLYFIN_URL=http://jellyfin.example.local:8096

# REQUIRED. Jellyfin: Dashboard -> API Keys.
JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key

# REQUIRED. Initialises the jfstats-db container and is interpolated into the
# DATABASE_URL the app container receives.
JFSTATS_DB_PASSWORD=replace-with-a-strong-password

# Host port for the dashboard. The container always listens on 3000; this only
# moves the published side if 3000 is taken.
JFSTATS_PORT=3000

# IANA timezone the three nightly maintenance jobs (03:00/03:30/04:00) run in,
# chosen to land in quiet viewing hours. Left as UTC they fire during peak
# evening viewing across the Americas.
TZ=UTC

# Turn both on ONLY behind an HTTPS reverse proxy. A Secure cookie over plain
# HTTP is silently dropped by the browser and looks exactly like a broken
# login; trusting X-Forwarded-For without a proxy that overwrites it lets any
# client forge a fresh rate-limit identity per request.
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

LOG_LEVEL=info

# --- Host-side dev flow only (ignored by docker compose) ------------------
#
# docker-compose.yml builds the container's DATABASE_URL from
# JFSTATS_DB_PASSWORD, pointed at the jfstats-db service. This one is
# host-facing, for `pnpm dev` / `seed` / `backfill`, and matches the loopback
# port docker-compose.override.yml publishes.
DATABASE_URL=postgres://jfstats:replace-with-a-strong-password@localhost:15432/jfstats

SESSION_POLL_INTERVAL_MS=5000
REFERENCE_SYNC_INTERVAL_MS=900000
COMPLETION_THRESHOLD=0.9
SESSION_TTL_HOURS=168
PORT=3000

# Emergency fallback administrator (optional; BOTH must be set to activate it).
# Accepted by /api/auth/login before Jellyfin is contacted, so it still works
# when Jellyfin is down - which is also why it is a standing password on your
# dashboard. Set it only if you need the recovery path, and remove it after.
# Not wired to docker-compose.yml: add both to the `jfstats` service's
# `environment:` block to use it there.
# FALLBACK_ADMIN_USER=rescue
# FALLBACK_ADMIN_PASSWORD=replace-with-a-long-random-password
